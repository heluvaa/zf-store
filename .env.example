# ── Wajib ────────────────────────────────────────────────────
# URL worker QRIS (tanpa slash di akhir)
STORE_QRIS_URL=https://qris-gateway.nybaee888.workers.dev
# = QRIS_HOOK_SECRET di worker (X-Webhook-Secret). Ambil dari ~/.hermes/.env
STORE_QRIS_SECRET=
# URL publik toko ini; dipakai sebagai callback_url ke gateway
STORE_PUBLIC_URL=https://zf-store.vercel.app
# Secret acak (32+ char) yang dipakai gateway untuk menandatangani callback
STORE_CALLBACK_SECRET=
# Secret untuk endpoint internal (/internal/sweep)
STORE_SWEEP_SECRET=
# Kunci admin (header x-admin-key) untuk melihat order tanpa access token
STORE_ADMIN_KEY=

# ── Durable store (produksi / Vercel) ────────────────────────
# Kosong = in-memory (HILANG saat proses mati; hanya untuk dev)
STORE_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# ── Opsional ─────────────────────────────────────────────────
PORT=3100
# KB/s: MDR QRIS merchant (placeholder, isi dari kontrak asli)
STORE_MDR_BPS=70
